{
  "functions": {
    "api/parse.js": {
      "maxDuration": 60
    },
    "api/notify.js": {
      "maxDuration": 60
    },
    "api/cron-reminders.js": {
      "maxDuration": 60
    },
    "api/push-register.js": {
      "maxDuration": 30
    },
    "api/deploy-rules.js": {
      "maxDuration": 30,
      "includeFiles": "firestore.rules"
    }
  },
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
